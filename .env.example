# ==============================================================================
# KJS India Digital Platform - Environment Configuration
# ==============================================================================

# Application
APP_ENV=development
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database (with pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kjs_db
POSTGRES_USER=kjs_admin
POSTGRES_PASSWORD=kjs_secret_pass
DATABASE_URL=postgresql+asyncpg://kjs_admin:kjs_secret_pass@localhost:5432/kjs_db
SUPERSET_DATABASE_URL=postgresql://kjs_readonly:kjs_readonly_pass@localhost:5432/kjs_db

# Direct (non-pooled) URL for Alembic migrations. Neon: same URL without "-pooler" in the host.
# asyncpg needs ?ssl=require (not sslmode / channel_binding).
MIGRATION_DATABASE_URL=

# Koko (LLM). groq | anthropic | none. Model ids change; check the provider's model list.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# First admin, created by `python -m app.seed`
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# Next.js -> FastAPI (server side + /api proxy)
API_INTERNAL_URL=http://127.0.0.1:8000
# KJS Chat live connection (WebSocket). Empty = automatic: `next dev` connects straight to the API on
# port 8000, a production build to its own site (nginx passes /api/v1/chat/ws on). Set it only when
# the API is somewhere else (the e2e build: ws://localhost:8001/api/v1/chat/ws). Read at build time.
NEXT_PUBLIC_CHAT_WS_URL=

# Lead Harvester (Client Schedulers). API keys for harvest sources must be settings named HARVEST_...
# (e.g. HARVEST_INDIAMART_API_KEY=...); a source can't read any other setting. Sources must use https;
# list a public host here (comma-separated) only if it has no https at all.
HARVEST_ALLOW_HTTP_HOSTS=

# Alert Channels
# Email (Resend or Brevo)
RESEND_API_KEY=re_placeholder
ALERT_FROM_EMAIL=alerts@kjsindia.com
# Firebase service-account JSON on ONE line (secret): notification emails go through Firestore "mail"
# (Trigger Email extension). Empty = SMTP below, or skipped (logged)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_MAIL_COLLECTION=mail

# WhatsApp Business Platform (Cloud API via Meta / BSP)
WHATSAPP_API_TOKEN=placeholder_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=placeholder_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=placeholder_waba_id

# File storage (order-board documents, product photos). "local" = folder on disk (dev); "r2" = Cloudflare R2
STORAGE_DRIVER=local
FILE_STORAGE_PATH=./storage
# Cloudflare R2 (only when STORAGE_DRIVER=r2): Cloudflare dashboard > R2 > Manage API tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Upload size and allowed types are tunable in config/storage.ini (not here)

# Email for notifications (any SMTP server). Leave SMTP_HOST empty and emails are skipped (logged).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=KJS India <no-reply@kjsindia.com>
# Full site URL, used for links inside emails
PUBLIC_BASE_URL=http://localhost:3000

# Tunable settings (SLA minutes, batch size, log levels, feature switches) live in config/*.ini,
# not in .env. Override any of them with KJS__<SECTION>__<KEY>, e.g. KJS__SLA__RESPOND_MINUTES=15
# CONFIG_DIR=/config   # only if the config folder is somewhere else (Docker)

# Apache Superset Embedded Analytics
SUPERSET_HOST=http://localhost:8088
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_GUEST_TOKEN_SECRET=superset_guest_jwt_secret
