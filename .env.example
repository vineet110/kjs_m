# ==============================================================================
# KJS India Digital Platform - Environment Configuration
# ==============================================================================

# Application
APP_ENV=development
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database (with pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kjs_db
POSTGRES_USER=kjs_admin
POSTGRES_PASSWORD=kjs_secret_pass
DATABASE_URL=postgresql+asyncpg://kjs_admin:kjs_secret_pass@localhost:5432/kjs_db
SUPERSET_DATABASE_URL=postgresql://kjs_readonly:kjs_readonly_pass@localhost:5432/kjs_db

# Direct (non-pooled) URL for Alembic migrations. Neon: same URL without "-pooler" in the host.
# asyncpg needs ?ssl=require (not sslmode / channel_binding).
MIGRATION_DATABASE_URL=

# Koko (LLM). groq | anthropic | none. Model ids change; check the provider's model list.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# First admin, created by `python -m app.seed`
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# Next.js -> FastAPI (server side + /api proxy)
API_INTERNAL_URL=http://127.0.0.1:8000

# Alert Channels
# Email (Resend or Brevo)
RESEND_API_KEY=re_placeholder
ALERT_FROM_EMAIL=alerts@kjsindia.com

# WhatsApp Business Platform (Cloud API via Meta / BSP)
WHATSAPP_API_TOKEN=placeholder_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=placeholder_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=placeholder_waba_id

# Storage for Order Board Documents
FILE_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=25

# Apache Superset Embedded Analytics
SUPERSET_HOST=http://localhost:8088
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_GUEST_TOKEN_SECRET=superset_guest_jwt_secret
