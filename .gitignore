# Node & Next.js
node_modules/
.next/
# Next.js rewrites this file on every dev/build run, so it is not tracked
frontend/next-env.d.ts
# Extra Next.js build folders for local test copies (e.g. .next-check for phone tests)
.next-*/
out/
build/
dist/
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/

# Environment files
.env
.env.local
.env.production

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Storage volume
/srv/
kjs_files/

# Downloaded from kjsindia.com by scripts/fetch_kjs_assets.py (13 MB of video; moves to Cloudflare R2 later)
frontend/public/images/kjs/video/
# Local file storage (dev)
storage/
backend/storage/

# TypeScript incremental build cache
*.tsbuildinfo

.next-e2e/
backend/storage-e2e/

# Any env file except the examples; backups and dumps never go in git
.env.*
!.env.example
!.env.production.example
!.env.backup.example
*.dump
*.tgz

# Neon agent skills (installed locally with `npx neon skills`, not shared)
.claude/skills/neon/
.claude/skills/neon-postgres/
skills-lock.json
