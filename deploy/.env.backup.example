# Off-site backup settings, read ONLY by deploy/backup.sh (never by the app).
# Copy to deploy/.env.backup on the server, fill in, then: chmod 600 .env.backup
# Guide: deploy/README.md, section 5, item 4 "Off-site copy".

# R2 bucket for backups and its OWN API token (Cloudflare > R2 > Manage API tokens:
# "Object Read & Write", limited to this one bucket). Not the app's token.
R2_BACKUP_BUCKET=kjs-bkp-prod
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=

# Encrypts the database backups before they leave the server. Long and random
# (e.g. `openssl rand -base64 32`). Keep a copy OFF the server (password manager):
# without it the off-site backups can't be opened.
BACKUP_PASSPHRASE=

# How long removed uploads and old database backups stay in the backup bucket (days)
OFFSITE_KEEP_DAYS=30
