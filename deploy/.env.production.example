# Production settings. Copy to deploy/.env on the server and fill in. NEVER commit deploy/.env.
# The app refuses to start if a value below is still unsafe (default secret, localhost URL...).
# Make a random secret:  openssl rand -hex 32

# --- App ---
APP_ENV=production
SECRET_KEY=
# The real site address (https). Used in emails, sitemap and robots.txt
PUBLIC_BASE_URL=https://www.kjsindia.com
ALLOWED_ORIGINS=https://www.kjsindia.com

# --- Database (the "db" container) ---
# Two users: "kjs" owns the tables (migrations, backups); "kjs_app" is what the app uses and may
# only read/write rows. Two different random passwords. (Env files can't reuse variables, so each
# password is also written out inside its URL.)
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
DATABASE_URL=postgresql+asyncpg://kjs_app:PASTE_APP_DB_PASSWORD_HERE@db:5432/kjs
# Superuser address, ONLY for migrations: deploy.sh / restore.sh pass it to that step; the running API
# never gets it (docker-compose.prod.yml blanks it, with POSTGRES_PASSWORD and the tunnel token).
MIGRATION_DATABASE_URL=postgresql+asyncpg://kjs:PASTE_POSTGRES_PASSWORD_HERE@db:5432/kjs

# --- First admin (python -m app.seed). After the first login: change the password in Profile,
#     then DELETE these two lines (the app doesn't need them any more) ---
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# --- Koko ---
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# --- Files: "r2" (Cloudflare R2, private bucket kjs-prod-files: what we use) or "local" (Docker volume) ---
# Backups of R2 files go to the backup bucket with its own key: deploy/.env.backup, NOT this file.
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Site pictures and flags: public R2 bucket kjs-site-assets (frontend/src/lib/assets.ts) ---
# Empty = served from the frontend's public/ folder, as before. Read when the frontend is BUILT,
# so a change needs a rebuild. The same address must also be in nginx/security-headers.conf (img-src).
# Test link: https://pub-2f2268655b7244e295313aaf35e31e54.r2.dev   Later: https://cdn.kjsindia.com
ASSET_BASE_URL=

# --- Email (empty SMTP_HOST = emails skipped and logged) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=KJS India <no-reply@kjsindia.com>
# Firebase service-account JSON on ONE line (secret): set = emails go through Firestore "mail", sent by
# the "Trigger Email from Firestore" extension (needed where SMTP is blocked, e.g. Render free).
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_MAIL_COLLECTION=mail

# --- Cloudflare Tunnel (only with --profile tunnel) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Version that is live. deploy.sh writes it (the git commit). Don't edit by hand, except for a
#     rollback (README section 4). Empty until the first ./deploy.sh ---
TAG=
