# Production settings. Copy to deploy/.env on the server and fill in. NEVER commit deploy/.env.
# The app refuses to start if a value below is still unsafe (default secret, localhost URL...).
# Make a random secret:  openssl rand -hex 32

# --- App ---
APP_ENV=production
SECRET_KEY=
# The real site address (https). Used in emails, sitemap and robots.txt
PUBLIC_BASE_URL=https://www.kjsindia.com
ALLOWED_ORIGINS=https://www.kjsindia.com

# --- Database (the "db" container) ---
POSTGRES_PASSWORD=
# Same password as above, written out in full (env files can't reuse variables)
DATABASE_URL=postgresql+asyncpg://kjs:PASTE_POSTGRES_PASSWORD_HERE@db:5432/kjs
MIGRATION_DATABASE_URL=

# --- First admin (python -m app.seed). Change the password after the first login ---
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# --- Koko ---
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# --- Files: "local" (Docker volume, included in backups) or "r2" (Cloudflare R2) ---
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Email (empty SMTP_HOST = emails skipped and logged) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=KJS India <no-reply@kjsindia.com>

# --- Cloudflare Tunnel (only with --profile tunnel) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Image tag for this deploy (deploy.sh sets it to the git commit) ---
TAG=latest
